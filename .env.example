# Copiar este archivo como .env  (cp .env.example .env)

# Base de datos. En local es un archivo SQLite; en producción, la URL de Turso.
DATABASE_URL=file:local.db
# Solo para Turso (en local se deja vacío)
DATABASE_AUTH_TOKEN=

# Secreto con el que se firma la cookie de sesión. Usar un texto largo y aleatorio.
# En producción se carga en Vercel y NUNCA se sube al repositorio.
SESSION_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
